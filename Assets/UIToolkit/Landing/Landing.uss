.screen {
    flex-grow: 1;
    align-items: center;
}

/* --- Header --- */
.header {
    position: absolute;
    top: 4%;
    left: 24px;
    right: 24px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center; /* was flex-end — this was the bug */
}

.header-icon-group {
    flex-direction: row;
    align-items: center;
}

/* --- Kid identity --- */
.kid-identity-shape {
    flex-direction: row-reverse;
    align-items: center;
    height: 93px;
    width: 233px;
}

.kid-avatar-image {
    height: 73px;
    width: 79px;
    border-radius: 8px;
    background-color: #FFFFFF;
}

.kid-name-text {
    background-color: #FFFFFF;
    -unity-text-align: middle-left;
    white-space: nowrap;
    text-overflow: ellipsis;
    padding: 4px 8px;
    border-radius: 6px;
}

/* --- Logo --- */
.logo-image {
    position: absolute;
    top: 10%;
    height: 220px;
    width: auto;
}

/* --- Buttons --- */
.button-column {
    position: absolute;
    bottom: 14%;
    align-items: center;
}

.version-label {
    position: absolute;
    bottom: 4%;
    left: 3%;
    font-size: 12px;
    color: #8A8574;
}
.play-button {
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.play-button-label {
    font-size: 30px;
    -unity-font-style: bold;
    color: #FFFFFF;
}

.play-button-icon {
    width: 0;
    height: 0;
    margin-left: 14px;
    border-left-width: 18px;
    border-top-width: 12px;
    border-bottom-width: 12px;
    border-left-color: #FFFFFF;
    border-top-color: transparent;
    border-bottom-color: transparent;
}