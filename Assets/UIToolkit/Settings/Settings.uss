.screen {
    flex-grow: 1;
}

.header {
    position: absolute;
    top: 24px;
    left: 24px;
    right: 24px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.screen-title {
    font-size: 22px;
    -unity-font-style: bold;
    color: #4A4739;
}

.settings-body {
    position: absolute;
    top: 100px;
    left: 24px;
    right: 24px;
    bottom: 24px;
    flex-direction: row;
}

.tab-menu {
    width: 200px;
}

.settings-tab-button {
    width: 180px;
    height: 52px;
    border-radius: 14px;
    margin-bottom: 10px;
    background-color: #FFFFFF;
    border-width: 1px;
    border-color: #D9D2C2;
    color: #4A4739;
    font-size: 15px;
    -unity-text-align: middle-left;
    padding-left: 20px;
}

.settings-tab-button.active {
    background-color: #7F77DD;
    color: #FFFFFF;
    border-color: #534AB7;
}

.working-space {
    flex-grow: 1;
    margin-left: 20px;
    background-color: #FFFFFF;
    border-radius: 20px;
    padding: 20px;
}
.working-space-content {
    flex-grow: 1;
    width: 100%;
    padding: 10px;
}