<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UIToolkit/Shared/Theme.uss?fileID=7433441132597879392&amp;guid=d884af507cd314bcd9c5583b17f71be5&amp;type=3#Theme"/>
    <Style src="project://database/Assets/UIToolkit/Settings/Components/AssistanceSettings.uss?fileID=7433441132597879392&amp;guid=e841220d3d7484e779c7b657338a1494&amp;type=3#AssistanceSettings"/>
    <ui:VisualElement name="working-space-content" class="working-space-content" style="width: 100%; height: 100%;">
        <ui:Label text="Session Settings" class="panel-heading"/>
        <ui:VisualElement class="setting-row">
            <ui:Label text="Number of activities" class="setting-label"/>
            <ui:VisualElement class="stepper-options">
                <ui:Button name="activities-3" text="3" class="btn stepper-option"/>
                <ui:Button name="activities-6" text="6" class="btn stepper-option active"/>
                <ui:Button name="activities-8" text="8" class="btn stepper-option"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="setting-row">
            <ui:Label text="Play time" class="setting-label"/>
            <ui:VisualElement class="stepper-options">
                <ui:Button name="playtime-20" text="20 m" class="btn stepper-option"/>
                <ui:Button name="playtime-30" text="30 m" class="btn stepper-option active"/>
                <ui:Button name="playtime-60" text="60 m" class="btn stepper-option"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="lock-overlay" class="lock-overlay" style="width: 100%; height: 100%; background-color: rgba(74, 71, 57, 0.67); border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-top-left-radius: 16px; border-top-right-radius: 16px; border-bottom-right-radius: 16px; border-bottom-left-radius: 16px;">
            <ui:Button name="unlock-button" text="Unlock" class="btn role-primary lock-overlay-button"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
