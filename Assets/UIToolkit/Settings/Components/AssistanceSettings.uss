.working-space-content {
    flex-grow: 1;
    padding: 10px;
    position: relative;
}

.panel-heading {
    font-size: 24px;
    -unity-font-style: bold;
    color: #4A4739;
    margin-bottom: 24px;
}

.setting-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 24px;
}

.setting-label {
    font-size: 16px;
    color: #4A4739;
    width: 200px;
}

.setting-toggle {
    margin-right: 0;
}

.stepper-options {
    flex-direction: row;
}

.stepper-option {
    width: 60px;
    height: 36px;
    margin-left: 8px;
    background-color: #FFFFFF;
    border-width: 1px;
    border-color: #D9D2C2;
    color: #4A4739;
    font-size: 13px;
}

.stepper-option.active {
    background-color: #7F77DD;
    color: #FFFFFF;
    border-color: #534AB7;
}

.lock-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(74, 71, 57, 0.55);
    align-items: center;
    justify-content: center;
}

.lock-overlay-button {
    width: 160px;
}

.settings-tab-button {
    width: 180px;
    height: 52px;
    border-radius: 14px;
    margin-bottom: 10px;
    background-color: #FFFFFF;
    border-width: 1px;
    border-color: #D9D2C2;
    flex-direction: row;
    align-items: center;
    padding-left: 16px;
}

.tab-icon {
    width: 20px;
    height: 20px;
    margin-right: 12px;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: #4A4739;
}

.tab-label {
    font-size: 15px;
    color: #4A4739;
}

.settings-tab-button.active .tab-label {
    color: #FFFFFF;
}

.settings-tab-button.active .tab-icon {
    -unity-background-image-tint-color: #FFFFFF;
}

.settings-tab-button.active {
    background-color: #7F77DD;
    border-color: #534AB7;
}