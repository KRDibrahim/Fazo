<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UIToolkit/Auth/Auth.uss?fileID=7433441132597879392&amp;guid=6bde6f38f2be342fd81fecc80209c7d1&amp;type=3#Auth"/>
    <ui:VisualElement name="root" class="screen" style="background-color: rgba(251, 243, 228, 0); align-items: center;">
        <ui:Label text="version 0" class="version-label"/>
        <ui:VisualElement name="auth-card" class="auth-card" style="top: 20%;">
            <ui:Label text="Continue with" class="card-heading"/>
            <ui:Button name="google" text="Continue with Google" class="btn btn-light"/>
            <ui:Button name="apple" text="Continue with Apple" class="btn btn-dark"/>
            <ui:Button name="guest" text="Play as a guest" class="btn btn-text"/>
        </ui:VisualElement>
        <ui:Label text="version 0.1" style="position: absolute; top: 96%; left: 0.5%; justify-content: flex-end; align-self: flex-start; align-content: flex-end; align-items: flex-start;"/>
    </ui:VisualElement>
    <ui:Image source="project://database/Assets/art/text/app%20name.png?fileID=2800000&amp;guid=8f3f13b2e4188492c8b31e08ae37c5ca&amp;type=3#app name" style="position: absolute; top: 5%; left: auto; height: 313px; align-items: center; justify-content: center; align-self: center;"/>
</ui:UXML>
