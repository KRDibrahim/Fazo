.screen {
    flex-grow: 1;
    background-color: #FBF3E4;
    /* Soft sky gradient, pure CSS-style, no image needed */
    background-image: none;
    align-items: center;
    justify-content: center;
}

.ground {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 28%;
    background-color: #B4D98A;
}

/* --- Tree silhouettes built from two shapes each --- */
.tree {
    position: absolute;
    bottom: 24%;
    width: 90px;
    height: 140px;
    align-items: center;
}
.tree-small {
    width: 60px;
    height: 100px;
    bottom: 25%;
}
.tree-canopy {
    width: 100%;
    height: 70%;
    border-radius: 100px;
    background-color: #7FB84A;
}
.tree-trunk {
    width: 14%;
    height: 30%;
    background-color: #5C3A22;
}

/* --- Title --- */
.title {
    position: absolute;
    top: 8%;
    font-size: 72px;
    -unity-font-style: bold;
    color: #534AB7;
    -unity-text-align: middle-center;
}

/* --- Auth card --- */
.auth-card {
    background-color: #FFFFFF;
    border-radius: 24px;
    padding: 32px;
    width: 340px;
    align-items: stretch;
    border-width: 2px;
    border-color: #E1D9C4;
}

.card-heading {
    font-size: 20px;
    -unity-font-style: bold;
    color: #4A4739;
    -unity-text-align: middle-center;
    margin-bottom: 20px;
}

/* --- Buttons --- */
.btn {
    height: 48px;
    border-radius: 24px;
    margin-bottom: 12px;
    font-size: 15px;
    -unity-font-style: bold;
    border-width: 1px;
}

.btn-light {
    background-color: #FFFFFF;
    color: #4A4739;
    border-color: #D9D2C2;
}

.btn-dark {
    background-color: #1A1A1A;
    color: #FFFFFF;
    border-width: 0;
}

.btn-text {
    background-color: transparent;
    color: #8A8574;
    border-width: 0;
    margin-bottom: 0;
    -unity-font-style: normal;
}

.version-label {
    position: absolute;
    bottom: 4%;
    left: 3%;
    font-size: 12px;
    color: #8A8574;
}
