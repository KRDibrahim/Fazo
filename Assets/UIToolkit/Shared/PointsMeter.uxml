<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UIToolkit/Shared/Theme.uss?fileID=7433441132597879392&amp;guid=d884af507cd314bcd9c5583b17f71be5&amp;type=3#Theme"/>
    <Style src="project://database/Assets/UIToolkit/Shared/PointsMeter.uss?fileID=7433441132597879392&amp;guid=9a6480f44c81c423c97f53cac755327e&amp;type=3#PointsMeter"/>
    <ui:VisualElement name="points-meter" class="points-meter" style="background-color: rgb(251, 243, 228); border-top-left-radius: 16px; border-top-right-radius: 16px; border-bottom-right-radius: 16px; border-bottom-left-radius: 16px; width: 200px; border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0); height: auto;">
        <ui:VisualElement name="points-icon" class="meter-icon icon-points" style="background-image: url(&quot;project://database/Assets/art/icons/point_icon.png?fileID=2800000&amp;guid=91f700dcb18e74e96b8f737edf26947e&amp;type=3#point_icon&quot;); -unity-background-image-tint-color: rgb(255, 255, 255); height: 40px; width: 40px;"/>
        <ui:Label name="points-value" text="120" class="points-value-text" style="align-self: center; -unity-text-align: upper-center; width: 108px;"/>
    </ui:VisualElement>
</ui:UXML>
