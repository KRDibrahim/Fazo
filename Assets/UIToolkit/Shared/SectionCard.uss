.section-card {
    width: 240px;
    border-radius: 24px;
    padding: 24px 18px;
    margin: 0 14px;
    align-items: center;
}

.section-card.locked {
    opacity: 0.55;
}

.lock-badge {
    position: absolute;
    top: 14px;
    right: 14px;
    width: 32px;
    height: 32px;
    border-radius: 16px;
    background-color: rgba(255, 255, 255, 0.9);
    align-items: center;
    justify-content: center;
}

.icon-lock-small {
    width: 16px;
    height: 16px;
    background-image: url("project://database/Assets/Art/icons/lock.svg");
    -unity-background-image-tint-color: #4A4739;
}


.section-robot-art {
    width: 120px;
    height: 120px;
    margin-bottom: 16px;
  
}


.section-title {
    font-size: 22px;
    -unity-font-style: bold;
    color: #4A4739;
    margin-bottom: 4px;
}

.section-subtitle {
    font-size: 13px;
    color: #8A8574;
    margin-bottom: 16px;
    -unity-text-align: middle-center;
}

.unlock-requirement {
    font-size: 13px;
    color: #8A8574;
    -unity-text-align: middle-center;
}

.section-unlock-btn {
    width: 100%;
    height: 40px;
    font-size: 14px;
}

.section-progress-track {
    width: 100%;
    height: 10px;
    border-radius: 5px;
    background-color: #EDE0D0;
    overflow: hidden;
}

.section-progress-fill {
    height: 100%;
    width: 0%;
    background-color: #534AB7;
    border-radius: 5px;
}
