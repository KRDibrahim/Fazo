<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Template name="ResponsibleProfileBadge" src="project://database/Assets/UIToolkit/KidDetails/components/ResponsibleProfileBadge.uxml?fileID=9197481963319205126&amp;guid=2ebca880830034ea6aa96a59935ff494&amp;type=3#ResponsibleProfileBadge"/>
    <Style src="project://database/Assets/UIToolkit/KidDetails/KidDetails.uss?fileID=7433441132597879392&amp;guid=f234513df811d44ffb5ef162132f2d5f&amp;type=3#KidDetails"/>
    <ui:VisualElement name="root" class="screen" style="background-color: rgba(251, 243, 228, 0);">
        <ui:VisualElement name="header" class="header">
            <ui:Button name="back-button" class="btn role-icon" style="background-color: rgba(252, 243, 229, 0.85); border-top-left-radius: 16px; border-top-right-radius: 16px; border-bottom-right-radius: 16px; border-bottom-left-radius: 16px;">
                <ui:VisualElement class="icon-back" style="height: 24px; width: 28px; background-color: rgba(0, 0, 0, 0);"/>
            </ui:Button>
            <ui:Label text="Kid Details" class="screen-title" style="font-size: 30px;"/>
            <ui:Instance template="ResponsibleProfileBadge">
                <AttributeOverrides element-name="responsible-photo" source="project://database/Assets/art/profiles/profilePic.jpeg?fileID=2800000&amp;guid=a7a44e6022cd34e539675bb7b7a3e754&amp;type=3#profilePic"/>
            </ui:Instance>
        </ui:VisualElement>
        <ui:VisualElement name="details-body" class="details-body">
            <ui:VisualElement name="left-column" class="left-column">
                <ui:VisualElement name="kid-card-slot" class="kid-card-slot"/>
                <ui:VisualElement name="spider-chart-slot" class="spider-chart-slot"/>
            </ui:VisualElement>
            <ui:VisualElement name="right-column" class="right-column">
                <ui:VisualElement name="domain-tab-row" class="domain-tab-row"/>
                <ui:ScrollView name="activity-list-scrollview" class="activity-list-scrollview">
                    <ui:VisualElement name="activity-section" class="activity-section"/>
                </ui:ScrollView>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
