.kid-summary-card {
    flex-direction: row;
    align-items: center;
    width: 100%;
    background-color: #FFFFFF;
    border-radius: 16px;
    padding: 10px 14px;
}
.kid-photo {
    width: 80px;
    height: 80px;
    border-radius: 16px;
    background-color: #F0C79A;
    border-width: 2px;
    border-color: #FFFFFF;
    flex-shrink: 0;
}

.kid-info-column {
    margin-left: 12px;
    justify-content: space-around;
    align-items: flex-start;
    height: 80px;
}

.kid-name-text {
    font-size: 16px;
    -unity-font-style: bold;
    color: #4A4739;
}

.kid-age-text {
    font-size: 12px;
    color: #8A8574;
}

.kid-level-text {
    font-size: 12px;
    -unity-font-style: bold;
    color: #7F77DD;
}

.action-btn-wrapper {
    margin-left: 16px;
    align-items: center;
    justify-content: center;
}

.action-btn {
    width: 38px;
    height: 38px;
    background-color: #F0C69A;
    border-radius: 20px;
}